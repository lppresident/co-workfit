# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:ios)

platform :ios do
  # Setup App Store Connect API Key for authentication
  desc "Setup App Store Connect API Key"
  lane :setup_api_key do
    if ENV["APP_STORE_CONNECT_API_KEY_ID"] && ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"] && ENV["APP_STORE_CONNECT_API_KEY_CONTENT"]
      app_store_connect_api_key(
        key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
        issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
        key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
        is_key_content_base64: true,
        in_house: false
      )
    else
      UI.user_error!("App Store Connect API Key environment variables are not set!")
    end
  end

  desc "Sync certificates and profiles using Match"
  lane :sync_code_signing do |options|
    type = options[:type] || "appstore"

    # Setup API Key first
    setup_api_key

    match(
      type: type,
      readonly: false,
      app_identifier: "com.hansol.coworkfit",
      keychain_name: "fastlane_tmp_keychain",
      keychain_password: ""
    )
  end

  desc "Build IPA for TestFlight (App Store)"
  lane :build_appstore do |options|
    # Sync certificates
    sync_code_signing(type: "appstore")

    # Update code signing settings to manual
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: "DRPP364BVT",
      profile_name: "match AppStore com.hansol.coworkfit",
      code_sign_identity: "Apple Distribution"
    )

    # Flutter build first (compile Dart code)
    Dir.chdir("..") do
      sh("flutter", "build", "ios", "--release", "--no-codesign")
    end

    # Build and sign with Xcode
    build_app(
      scheme: "Runner",
      workspace: "Runner.xcworkspace",
      export_method: "app-store",
      output_directory: "../build/ios/ipa",
      output_name: "co_workfit.ipa",
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        provisioningProfiles: {
          "com.hansol.coworkfit" => "match AppStore com.hansol.coworkfit"
        }
      }
    )
  end

  desc "Upload to TestFlight"
  lane :beta do |options|
    # Setup API Key first
    setup_api_key

    # Build
    build_appstore

    # Upload to TestFlight (API key is automatically used)
    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      app_identifier: "com.hansol.coworkfit"
    )
  end

  desc "Upload IPA to TestFlight (for CI)"
  lane :upload_testflight do |options|
    # Setup API Key and store it
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: true,
      in_house: false
    )

    ipa_path = options[:ipa] || "../build/ios/ipa/co_workfit.ipa"
    changelog = options[:changelog] || "New build"

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path,
      skip_waiting_for_build_processing: true,
      app_identifier: "com.hansol.coworkfit",
      changelog: changelog
    )
  end
end
